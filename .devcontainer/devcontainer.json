{
  "name": "crewgate-mcp",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "pipx install uv && uv sync && uv run pre-commit install",
  "forwardPorts": [8000, 8001, 8080, 9090, 3000],
  "portsAttributes": {
    "8000": { "label": "MCP gateway" },
    "8001": { "label": "Mock crew-roster API" },
    "8080": { "label": "Keycloak" },
    "9090": { "label": "Prometheus" },
    "3000": { "label": "Grafana" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.mypy-type-checker", "github.vscode-github-actions"],
      "settings": { "python.defaultInterpreterPath": ".venv/bin/python" }
    }
  }
}
