# Copy to .env for local runs. .env is git-ignored. In CI these come from GitHub Actions secrets.

# Crew plugin -> mock crew-roster partner API
CREW_API_BASE_URL=http://localhost:8001
CREW_CLIENT_ID=crewgate-agent
CREW_CLIENT_SECRET=dev-only-secret
CREW_SCOPES=roster.read swap.write

# Mock partner API
MOCKAPI_JWT_SIGNING_KEY=replace-with-a-long-random-string

# Booking plugin (Day 5). Test-mode token only: it must start with duffel_test_
# DUFFEL_TEST_TOKEN=
# DUFFEL_WEBHOOK_SECRET=
